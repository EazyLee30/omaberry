+
+  /* Characters, on top of the button mask.
+   *
+   * The mask is what games and the focus manager want: Space becomes START,
+   * Menu becomes TRIANGLE. A terminal wants the opposite -- Space is a space,
+   * and every printable key is itself. Both are delivered; the guest decides
+   * which it cares about, so neither kind of app has to be sacrificed.
+   *
+   * Only key-down and key-repeat produce text; a release produces none.
+   */
+  if (flags & (SCREEN_FLAG_KEY_DOWN | SCREEN_FLAG_KEY_REPEAT)) {
+    /* screen.h, on SCREEN_PROPERTY_KEY_ALTERNATE_SYM:
+     *   "On reduced keyboards with a limited number of keys, the alternate key
+     *    symbol may correspond to a non-printable shortcut or command symbol
+     *    while the main key symbol would be suitable for text entry."
+     *
+     * The Q20 is exactly that reduced keyboard, and there is no composed
+     * Unicode property to read -- SCREEN_PROPERTY_UNICODE does not exist in
+     * this SDK. So the main key symbol is the character. The alternate symbol
+     * is delivered separately so a host that wants Alt-chords can read it.
+     */
+    int symbol_for_text = 0;
+    if (screen_get_event_property_iv(event, SCREEN_PROPERTY_KEY_SYM, &symbol_for_text) == 0 &&
+        symbol_for_text > 0x20 && symbol_for_text < 0x7F0000) {
+      unsigned char encoded[4];
+      int length = encode_utf8(encoded, (unsigned int)symbol_for_text);
+      if (length > 0) pocket_runtime_push_text(encoded, (size_t)length);
+    }
+  }
+}
+
+/* The key symbol is a codepoint; the runtime takes UTF-8 bytes. One
+ * codepoint is at most four bytes, and the surrogate range is not valid. */
+static int encode_utf8(unsigned char *out, unsigned int cp)
+{
+  if (cp == 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF)) return 0;
+  if (cp < 0x80) { out[0] = (unsigned char)cp; return 1; }
+  if (cp < 0x800) {
+    out[0] = (unsigned char)(0xC0 | (cp >> 6));
+    out[1] = (unsigned char)(0x80 | (cp & 0x3F));
+    return 2;
+  }
+  if (cp < 0x10000) {
+    out[0] = (unsigned char)(0xE0 | (cp >> 12));
+    out[1] = (unsigned char)(0x80 | ((cp >> 6) & 0x3F));
+    out[2] = (unsigned char)(0x80 | (cp & 0x3F));
+    return 3;
+  }
+  out[0] = (unsigned char)(0xF0 | (cp >> 18));
+  out[1] = (unsigned char)(0x80 | ((cp >> 12) & 0x3F));
+  out[2] = (unsigned char)(0x80 | ((cp >> 6) & 0x3F));
+  out[3] = (unsigned char)(0x80 | (cp & 0x3F));
+  return 4;
 }
 
