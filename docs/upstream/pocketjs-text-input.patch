+/*
+ * Queue typed characters for the next guest turn.
+ *
+ * The frame wire has a button mask and touch contacts and nothing else, so a
+ * host with a real keyboard can only report Space as START and Menu as
+ * TRIANGLE -- no character ever reaches the app. Hosts with text input call
+ * this with UTF-8 bytes; they are drained into the fifth argument of the
+ * guest's frame() call. A guest that does not accept the extra argument is
+ * unaffected, which is why this is additive rather than a struct change.
+ *
+ * Returns 1 when the bytes were queued, 0 when the queue is full (the input
+ * is dropped, not partially written).
+ */
+int pocket_runtime_push_text(const uint8_t *utf8, size_t length);
