 /* One guest turn (frame call + job drain), then `tick_count` core ticks. */
+/* ── pending text ────────────────────────────────────────────────────────
+ * The frame wire carries a button mask and touch contacts; it has nowhere to
+ * put typed characters, so a QWERTY host can only report Space as START and
+ * Menu as TRIANGLE. Text arrives here instead and is drained as the fifth
+ * argument to the guest's frame() call.
+ *
+ * Adding an argument is deliberately the compatibility-preserving shape:
+ * every existing guest declares frame(buttons, analog, touches, hits) and
+ * simply never looks at the fifth, so no host and no app has to change.
+ *
+ * Bounded and lossy on overflow -- a keyboard cannot outrun a frame, and an
+ * unbounded queue on a 2 GB device is not worth the failure mode.
+ */
+#define POCKET_TEXT_QUEUE 64
+#define POCKET_TEXT_SLOT  24   /* one codepoint is 4 bytes; a paste is queued whole */
+static char text_queue[POCKET_TEXT_QUEUE][POCKET_TEXT_SLOT];
+static unsigned int text_queue_len[POCKET_TEXT_QUEUE];
+static unsigned int text_queue_head;
+static unsigned int text_queue_tail;
+
+int pocket_runtime_push_text(const uint8_t *utf8, size_t length) {
+  size_t offset = 0;
+  if (utf8 == NULL || length == 0) return 0;
+  /* Split long input across slots rather than truncating it. */
+  while (offset < length) {
+    unsigned int next = (text_queue_head + 1) % POCKET_TEXT_QUEUE;
+    size_t chunk = length - offset;
+    if (next == text_queue_tail) return 0;   /* full: drop the rest */
+    if (chunk > POCKET_TEXT_SLOT) chunk = POCKET_TEXT_SLOT;
+    memcpy(text_queue[text_queue_head], utf8 + offset, chunk);
+    text_queue_len[text_queue_head] = (unsigned int)chunk;
+    text_queue_head = next;
+    offset += chunk;
+  }
+  return 1;
+}
